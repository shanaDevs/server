{
  "name": "pos-server",
  "version": "1.0.0",
  "description": "Advanced POS System Backend with Multi-Company Support, Inventory Management, Sales, and Customer Loyalty - Built with Node.js, Express, and MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node init && node server.js",
    "dev": "node init && nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "tsoa:build": "npm run tsoa:spec && npm run tsoa:routes && npm run swagger:combine",
    "swagger:combine": "node src/scripts/generateCombinedSwagger.js",
    "prebuild": "npm run tsoa:build",
    "build": "node init && tsc",
    "dev:tsoa": "node init && npm run tsoa:build && nodemon server.js"
  },
  "keywords": [
    "pos",
    "express",
    "mysql",
    "sequelize",
    "inventory-management",
    "sales-management",
    "customer-loyalty",
    "multi-company",
    "api",
    "rest-api"
  ],
  "author": "Shyamal Dartcodes",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.8.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "googleapis": "^169.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.15.0",
    "sequelize": "^6.35.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tsoa": "^7.0.0-alpha.0",
    "twilio": "^5.11.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
