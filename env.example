# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_db
DB_USER=root
DB_PASSWORD=

# Email Configuration (for sending notifications, GRN/PO emails)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMS Configuration (Optional - for SMS notifications via Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE=+1234567890

# Company Branding (for email templates)
COMPANY_NAME=Your Store Name
COMPANY_EMAIL=info@yourstore.com
STORE_URL=https://yourstore.com

# JWT Configuration (if needed later)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d

